# Local Python/Node environments and generated caches.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Downloaded inference environments, model weights, and native runtime binaries.
/tools/model-runtimes/

# Codex session attachments and unrelated account-storage backups.
/.codex-remote-attachments/
/logs/account-storage-audit-*/

# Local credentials and machine-specific settings.
.env
.env.*
!.env.example
*.pem
*.key

# Interrupted telemetry publication and unit-test scratch folders.
*.tmp
/tools/offline-bot/tests/*-scratch-*/
/logs/offline-bot/test-temp/
/tools/hud-reader/.bsgo-hud-perf-*/

# Runtime captures, traces, reports, and machine-specific launcher state.
# logs/ is a junction to E:/workspace/bsgo/logs on the author's machine.
/logs/

# No images or captured data in the repository. The app's own runtime images
# and the packed test fixtures are the only exceptions; tests restore their
# images from tools/test-fixtures (see restore.py) into these ignored paths.
*.png
*.jpg
*.jpeg
*.bmp
*.webp
*.gif
!/tools/offline-bot/bsgo_offline/data/**
!/tools/test-fixtures/sheets/*.png
/test-data/
/tools/hud-reader/runs/
/tools/test-fixtures/.restored
